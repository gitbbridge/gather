# Gather sandbox only. Copy to a secure, untracked environment store.
GATHER_ENVIRONMENT=staging
APP_URL=https://sandbox.gatherforgood.bid
SANDBOX_TESTER_EMAILS=owner-controlled-test-email@example.com
STAGING_ORGANIZER_EMAIL=nonprofit-test-account@example.com
SANDBOX_DEMO_PASSWORD=replace_me_with_a_test_only_password

# Dedicated staging Supabase project. Never use the production project.
STAGING_SUPABASE_PROJECT_REF=your_staging_project_ref
PRODUCTION_SUPABASE_PROJECT_REF=your_production_project_ref
NEXT_PUBLIC_SUPABASE_URL=https://your_staging_project_ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_staging_publishable_key
SUPABASE_SECRET_KEY=your_staging_secret_key
PLATFORM_ADMIN_EMAILS=owner-controlled-admin-test-email@example.com
REQUIRE_PRIVILEGED_MFA=true

# Dedicated Cloudflare D1 database identifiers. The application binding remains DB.
STAGING_D1_DATABASE_ID=your_staging_d1_database_id
PRODUCTION_D1_DATABASE_ID=your_production_d1_database_id

# Stripe test mode only.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# All application email is redirected to this owner-controlled inbox in staging.
EMAIL_DELIVERY_MODE=test_sink
TEST_EMAIL_RECIPIENT=owner-controlled-test-email@example.com
RESEND_API_KEY=re_replace_me_with_staging_key
RESEND_FROM_EMAIL=Gather Sandbox <sandbox@gatherforgood.bid>
RESEND_BCC_EMAIL=
