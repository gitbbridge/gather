import {test} from 'node:test';
import assert from 'node:assert/strict';
import {emailTemplates,previewTemplate,renderEmailTemplate,supabaseEmailConfig} from '../lib/email/templates.ts';

test('email library covers required auth, security, auction, payment, and travel messages',()=>{const ids=new Set(emailTemplates.map(template=>template.id));assert.equal(ids.size,emailTemplates.length);for(const required of ['auth-confirm-signup','auth-reset-password','security-password-changed','outbid','winner','invoice-ready','payment-receipt','refund','travel-details-needed','travel-confirmed','organizer-auction-closed'])assert.ok(ids.has(required),`missing ${required}`);assert.ok(emailTemplates.length>=27);});
test('every email is complete responsive HTML with a subject and preview',()=>{for(const template of emailTemplates){assert.match(template.html,/^<!doctype html>/i);assert.match(template.html,/viewport/);assert.match(template.html,/gatherforgood\.bid/);assert.ok(template.subject.length>5);assert.ok(template.description.length>10);assert.doesNotMatch(previewTemplate(template).html,/{{\s*[.]?[A-Za-z]/,template.id);}});
test('transactional renderer requires and safely escapes variables',()=>{assert.throws(()=>renderEmailTemplate('outbid',{}),/Missing email variable/);const values={itemTitle:'<Five nights>\r\nBcc: nope',currentBid:'$2,450',minimumBid:'$2,500',timeRemaining:'2 hours',itemUrl:'https://gatherforgood.bid/item?a=1&b=2'};const rendered=renderEmailTemplate('outbid',values);assert.doesNotMatch(rendered.subject,/\r|\n/);assert.doesNotMatch(rendered.html,/<Five nights>/);assert.match(rendered.html,/&lt;Five nights&gt;/);});
test('Supabase export contains paired subject and HTML keys for every auth template',()=>{const config=supabaseEmailConfig();const auth=emailTemplates.filter(template=>template.provider==='Supabase Auth');assert.equal(Object.keys(config).length,auth.length*2);for(const template of auth){assert.equal(config[template.providerKey!],template.html);assert.equal(config[template.subjectKey!],template.subject);}});
