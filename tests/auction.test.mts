import {test} from 'node:test';
import assert from 'node:assert/strict';
import {bid,createAuction,publicState} from '../lib/auction.ts';
const fixture=()=>createAuction().items[0];
test('first bid charges the opening price, not the private maximum',()=>{const i=fixture();bid(i,'a',50000,Date.now());assert.equal(i.price,20000);assert.equal(i.leader,'a');});
test('proxy bids charge one increment above the competing maximum',()=>{const i=fixture();bid(i,'a',50000,Date.now());bid(i,'b',30000,Date.now()+1);assert.equal(i.price,32500);assert.equal(i.leader,'a');});
test('equal maxima favor the earlier bidder and never exceed maximum',()=>{const i=fixture();bid(i,'a',50000,1);bid(i,'b',50000,2);assert.equal(i.leader,'a');assert.equal(i.price,50000);});
test('closed, sold, fractional, and below-minimum bids fail',()=>{for(const amount of [0,19999,20000.5,NaN,Infinity])assert.throws(()=>bid(fixture(),'a',amount,Date.now()));const i=fixture();assert.throws(()=>bid(i,'a',50000,i.ends));i.sold=true;assert.throws(()=>bid(i,'a',50000,Date.now()));});
test('late bids extend the deadline by two minutes',()=>{const i=fixture();const t=i.ends-1000;bid(i,'a',50000,t);assert.equal(i.ends,t+120000);});
test('view never exposes another bidder maximum or identity',()=>{const a=createAuction();bid(a.items[0],'secret-id',99900,Date.now());const view=publicState(a,'other',false);assert.equal(view.items[0].myMax,0);assert.equal(view.items[0].bids,undefined);assert.equal(view.items[0].leader,undefined);assert.ok(!JSON.stringify(view).includes('secret-id'));});
test('raising own maximum does not increase the first bid price',()=>{const i=fixture();bid(i,'a',50000,1);bid(i,'a',60000,2);assert.equal(i.price,20000);assert.equal(i.bids.length,1);});
test('created auctions persist the approved 5% allocation and starter details',()=>{const a=createAuction('Spring auction','Community Fund',{starts:1000,ends:2000,organizerPercent:40,items:[{title:'Garden tour',value:30000}]});assert.deepEqual(a.feePolicy,{platformRateBps:500,organizerPercent:40,bidderPercent:60,paymentProcessingFeesSeparate:true,giveHolidaysMarkupSeparate:true});assert.equal(a.starts,1000);assert.equal(a.ends,2000);assert.equal(a.items.length,1);assert.equal(a.items[0].title,'Garden tour');assert.equal(a.items[0].value,30000);});
test('Give Holidays selections become travel packages without invented package terms',()=>{const a=createAuction('Travel auction','Community Fund',{items:[{title:'Maui getaway',value:0,source:'give-holidays',packageCode:'MAUI'}]});assert.equal(a.items[0].category,'Getaways');assert.equal(a.items[0].donor,'Give Holidays');assert.equal(a.items[0].source,'give-holidays');assert.equal(a.items[0].giveHolidaysPackageCode,'MAUI');assert.match(a.items[0].description,/confirmed before publication/);});
test('draft travel packages stay hidden from bidders but visible to organizers',()=>{const a=createAuction();a.items[0].source='give-holidays';a.items[0].isPublished=false;assert.equal(publicState(a,'bidder',false).items.some(item=>item.id===a.items[0].id),false);assert.equal(publicState(a,'owner',true).items.some(item=>item.id===a.items[0].id),true);});
test('existing and unspecified events remain online silent auctions',()=>{const a=createAuction();assert.equal(a.eventType,'online_silent');assert.equal(a.paused,false);assert.equal(a.liveSessionStatus,'not_started');});
test('live onboarding stores planning intent without starting live bidding',()=>{const a=createAuction('Spring gala','Community Fund',{eventType:'live',eventStartsAt:1800000000000,venueName:'Grand Ballroom',venueAddress:'Denver, CO',plannedCapabilities:{liveAuction:true,donationAppeal:true}});assert.equal(a.eventType,'live');assert.equal(a.paused,true);assert.equal(a.liveSessionStatus,'not_started');assert.equal(a.plannedCapabilities.liveAuction,true);assert.equal(a.plannedCapabilities.donationAppeal,true);});
test('hybrid events preserve online bidding and in-person details',()=>{const a=createAuction('Hybrid gala','Community Fund',{eventType:'hybrid',starts:1000,ends:2000,eventStartsAt:1900,venueName:'Community Hall'});assert.equal(a.eventType,'hybrid');assert.equal(a.starts,1000);assert.equal(a.ends,2000);assert.equal(a.venueName,'Community Hall');assert.equal(a.paused,false);});
